# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Virtual Environments
venv/
.venv/
env/
ENV/
python/

# Private environment variables, secrets & credentials
.env
.env.*
*.lic
backend/secrets.json
trial_lambda_url.txt

# Docker configurations & artifacts
[Dd]ockerfile*
.dockerignore
docker-compose*

# AWS Lambda artifacts
trial_lambda/
lambda_*/
lambda_*.*

# Local data input/output drop zones
uploads/
temp_uploads/
outputs/
logs/
*.log

# Spreadsheets, data & document files
*.xlsx
*.xml
*.json
*.pdf
*.zip
*.tex
*.txt

# Build & packaging artifacts
build/
dist/
obf_dist/
.pyarmor/
*.exe

# PyInstaller specs (keep only primary PDF2TALLY.spec)
*.spec
!PDF2TALLY.spec

# Developer scratch & prototype directories
scratch/
help_prototype/

# Explicit whitelist exceptions
!requirements.txt
!telugu_mappings.json
!assets/**
!docs/**